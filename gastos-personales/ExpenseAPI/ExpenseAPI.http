@ExpenseAPI_HostAddress = http://localhost:5046

### Register expense
# @name registerExpense
POST {{ExpenseAPI_HostAddress}}/expenses
Content-Type: application/json

{
  "concept": "Groceries",
  "amount": 45.90,
  "date": "2026-09-26",
  "currency": "EUR",
  "idCategory": "2f3c1b8a-6d4e-4a91-9b27-5c8d0e7f1234",
  "note": "Weekly shopping"
}

### Get expenses
GET {{ExpenseAPI_HostAddress}}/expenses
Accept: application/json

### Delete registered expense
DELETE {{ExpenseAPI_HostAddress}}/expenses/a741ca79-c1f7-4288-8096-0b9e19e79933
Accept: application/json

### Create category
# @name createCategory
POST {{ExpenseAPI_HostAddress}}/categories
Content-Type: application/json

{
  "name": "Groceries"
}

### Get categories
GET {{ExpenseAPI_HostAddress}}/categories
Accept: application/json

### Delete created category
DELETE {{ExpenseAPI_HostAddress}}/categories/{{createCategory.response.body.$.id}}
Accept: application/json

### Delete a category that does not exist
DELETE {{ExpenseAPI_HostAddress}}/categories/00000000-0000-0000-0000-000000000000
Accept: application/json